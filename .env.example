# Csak a backend olvassa; VITE_ előtagú titkokat ne használj.
APP_URL=http://localhost:5173
GOOGLE_REDIRECT_URI=http://localhost:5173/api/integrations/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 véletlen bájt, 64 hexadecimális karakter; biztonságosan őrizd meg.
INTEGRATION_ENCRYPTION_KEY=
# A szolgáltató lehet gemini vagy openai; a Gemini ingyenes kerete korlátozott.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Csak LLM_PROVIDER=openai esetén szükséges:
OPENAI_API_KEY=
# A fiókodban elérhető, Responses API-t támogató szöveges modell neve.
OPENAI_MODEL=
