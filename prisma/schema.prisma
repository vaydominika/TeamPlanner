generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id              String          @id
  name            String
  email           String          @unique
  passwordHash    String
  role            String
  managedProjects Project[]       @relation("ProjectManager")
  ledTeams        Team[]          @relation("TeamLeader")
  teamMemberships TeamMember[]
  sessions        Session[]
  assignedTasks   Task[]           @relation("TaskAssignee")
  calendarConnection CalendarConnection?
  calendarAuthorization CalendarAuthorization?
}

model Team {
  id          Int          @id @default(autoincrement())
  name        String
  description String
  leaderId    String
  leader      User         @relation("TeamLeader", fields: [leaderId], references: [id])
  members     TeamMember[]
  projects    Project[]
}

model TeamMember {
  teamId Int
  userId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

model Session {
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id          Int             @id @default(autoincrement())
  name        String
  description String
  managerId   String
  teamId      Int?
  manager     User            @relation("ProjectManager", fields: [managerId], references: [id])
  team        Team?           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tasks       Task[]
}

model Task {
  id          Int     @id @default(autoincrement())
  projectId   Int
  name        String
  description String
  assignee    String
  assigneeId  String?
  assignedUser User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  deadline    String
  status      String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  calendarEvents CalendarEvent[]
}

model CalendarConnection {
  id          String          @id
  userId      String          @unique
  provider    String
  credentials String?
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events      CalendarEvent[]
}

model CalendarAuthorization {
  userId      String   @id
  stateHash   String   @unique
  sessionHash String
  verifier    String
  expiresAt   DateTime
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CalendarEvent {
  id              Int                @id @default(autoincrement())
  connectionId    String
  taskId          Int?
  externalEventId String
  dirty           Boolean            @default(true)
  revision        Int                @default(0)
  lastError       String?
  connection      CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  task            Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([connectionId, taskId])
  @@index([taskId])
}
